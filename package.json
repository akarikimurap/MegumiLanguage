{
  "name": "megumi-language",
  "version": "0.2.0-beta",
  "private": true,
  "description": "Megumi Language — Megumi Projesi'nin Türkçe (ve İngilizce) ile Japonca öğrenme uygulaması",
  "scripts": {
    "postinstall": "node tools/postinstall.mjs",
    "serve": "npx http-server@14.1.1 www -p 5173 -c-1",
    "strokes": "node tools/build-strokes.mjs",
    "dict": "node tools/build-dict.mjs",
    "reader": "node tools/build-reader.mjs",
    "check": "node tools/check-data.mjs",
    "icons": "node tools/make-logo.mjs && capacitor-assets generate --android --iconBackgroundColor #d94f70 --iconBackgroundColorDark #d94f70 --splashBackgroundColor #fbf7f4 --splashBackgroundColorDark #161113",
    "android:add": "cap add android",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "fflate": "0.8.3",
    "kuromoji": "0.1.2",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3"
  },
  "license": "MIT"
}
